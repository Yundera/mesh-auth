{
  "name": "@aptero/mesh-router-auth",
  "version": "0.3.0",
  "description": "OIDC client registration service. Derives client_id from the caller's docker container name via PTR lookup. Pluggable backend: Authelia (register-oidc-client.sh) or Dex (gRPC CreateClient), selected via REGISTRAR_BACKEND.",
  "main": "dist/index.js",
  "type": "module",
  "private": false,
  "scripts": {
    "exec": "concurrently \"tsc && node dist\"",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "tsc-watch --onSuccess \"node ./dist\"",
    "test": "tsc && mocha dist/**/*.spec.js",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "express": "^5.2.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/chai": "^5.0.1",
    "@types/express": "^5.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.15.29",
    "chai": "^5.2.0",
    "concurrently": "^9.2.1",
    "eslint": "9.39.2",
    "mocha": "11.7.5",
    "tsc-watch": "^6.2.1"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
